{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-Client-Id",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 200 },
      { "Endpoint": "POST:/api/v1/auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "POST:/api/v1/auth/register", "Period": "1m", "Limit": 5 },
      { "Endpoint": "POST:/api/v1/auth/forgot-password", "Period": "1h", "Limit": 5 },
      { "Endpoint": "POST:/api/v1/employee/auth/login", "Period": "1m", "Limit": 10 }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "/var/log/bookzone/log-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 90 } },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341", "apiKey": "" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
  }
}