# =============================================================================
# E-Commerce Book Platform - Environment Variables Template
# Copy to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# APP SETTINGS
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# -----------------------------------------------------------------------------
# DATABASE (SQL Server)
# -----------------------------------------------------------------------------
# Development: LocalDB / Docker SQL Server
# ConnectionStrings__DefaultConnection=Server=localhost;Database=db_nhasach;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False
# Production: SQL Server with SQL auth
# ConnectionStrings__DefaultConnection=Server=db;Database=db_nhasach;User=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;Encrypt=False

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Development
ConnectionStrings__Redis=localhost:6379
# Production
# ConnectionStrings__Redis=redis:6379

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate a secure 32+ char secret: openssl rand -base64 32
Jwt__Secret=your-super-secret-jwt-key-min-32-chars-change-in-production
Jwt__Issuer=ECommerceBookPlatform
Jwt__Audience=ECommerceBookPlatform

# -----------------------------------------------------------------------------
# CORS - Comma-separated origins (no spaces)
# -----------------------------------------------------------------------------
# Development
Cors__AllowedOrigins=http://localhost:4200,http://localhost:3000
# Production
# Cors__AllowedOrigins=https://bookzone.vn,https://www.bookzone.vn

# -----------------------------------------------------------------------------
# EMAIL (MailKit)
# -----------------------------------------------------------------------------
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPass=
Email__FromEmail=noreply@bookzone.vn
Email__FromName=BookZone
Email__EnableSsl=true
# Frontend base URL for email links (password reset, order confirmation, etc.)
Email__BaseUrl=http://localhost:4200

# -----------------------------------------------------------------------------
# VNPAY PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Get credentials from: https://business.vnpay.vn/
# Sandbox (Development)
VnPay__TmnCode=DEMO_TMN_CODE
VnPay__HashSecret=DEMO_HASH_SECRET
VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__ReturnUrl=http://localhost:4200/payment/vnpay-return
VnPay__IpnUrl=http://localhost:5000/api/v1/payment/vnpay-ipn
# Production
# VnPay__TmnCode=YOUR_PROD_TMN_CODE
# VnPay__HashSecret=YOUR_PROD_HASH_SECRET
# VnPay__BaseUrl=https://vnpayment.vn/paymentv2/vpcpay.html
# VnPay__ReturnUrl=https://bookzone.vn/payment/vnpay-return
# VnPay__IpnUrl=https://api.bookzone.vn/api/v1/payment/vnpay-ipn
VnPay__Version=2.1.0
VnPay__Command=pay
VnPay__Locale=vn
VnPay__CurrCode=VND

# -----------------------------------------------------------------------------
# SERILOG
# -----------------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__1__Name=File
Serilog__WriteTo__1__Args__path=logs/log-.txt
Serilog__WriteTo__1__Args__rollingInterval=Day
Serilog__WriteTo__1__Args__retainedFileCountLimit=30

# -----------------------------------------------------------------------------
# HEALTH CHECKS
# -----------------------------------------------------------------------------
HealthChecks__SqlServer__ConnectionString=Server=localhost;Database=db_nhasach;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False
HealthChecks__Redis__ConnectionString=localhost:6379

# -----------------------------------------------------------------------------
# RATE LIMITING (optional overrides)
# -----------------------------------------------------------------------------
# RateLimiting__EnableEndpointRateLimiting=true
# RateLimiting__HttpStatusCode=429

# -----------------------------------------------------------------------------
# FILE STORAGE (SeaweedFS) - Production
# -----------------------------------------------------------------------------
# Get from: https://github.com/seaweedfs/seaweedfs
# Master URL (internal)
SeaweedFS__MasterUrl=http://seaweedfs-master:9333
# Public CDN URL (external access)
SeaweedFS__PublicUrl=https://cdn.bookzone.vn
# Replication: 001 = 1 copy same rack, 010 = 1 copy different rack, 100 = 1 copy different DC
SeaweedFS__Replication=001
SeaweedFS__HttpTimeoutSeconds=30

# -----------------------------------------------------------------------------
# FILE STORAGE (Local) - Development Fallback
# -----------------------------------------------------------------------------
FileStorage__PublicBaseUrl=http://localhost:5000