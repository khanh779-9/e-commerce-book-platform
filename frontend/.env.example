# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env (dev) or .env.production (prod) and fill in values
# =============================================================================

# Frontend SSR server port
PORT=5000

# Frontend URLs (Development)
FRONTEND_URL_DEV=http://localhost:4200
FRONTEND_URL_SSR=http://localhost:5000

# Backend API URL (Development)
BACKEND_URL=http://localhost:5132

# --- Production (uncomment and set in .env.production) ---
# PORT=5000
# FRONTEND_URL_DEV=https://bookzone.vn
# FRONTEND_URL_SSR=https://bookzone.vn
# BACKEND_URL=https://api.bookzone.vn